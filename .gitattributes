# Scripts and configs run inside Linux containers / Jenkins - always keep LF line endings,
# otherwise "bash\r: No such file or directory" errors appear when they are cloned on Windows.
*.sh            text eol=lf
*.py            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.txt           text eol=lf
Dockerfile*     text eol=lf
Jenkinsfile     text eol=lf
*-profile       text eol=lf

*.jpg           binary
*.png           binary
*.pdf           binary
